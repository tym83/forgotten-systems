# Декодер RISC5 для QEMU (decodetree).
#
# Поля сняты не с документации, а с самого железа — RISC5.v Никлауса Вирта:
#   p=IR[31] q=IR[30] u=IR[29] v=IR[28]
#   a=IR[27:24]  b=IR[23:20]  op=IR[19:16]  c=IR[3:0]
# Те же значения использует наш дизассемблер, замкнутый в круг с ассемблером
# сплошным перебором пространства команд.
#
# Четыре формата различаются парой старших битов:
#   00uv  регистр-регистр        F0
#   01uv  регистр-непосредственное F1
#   10uv  загрузка/запись        F2   (u=0 читать, u=1 писать; v — байт)
#   110v  переход по регистру    F3
#   111v  переход по смещению    F3   (v — со ссылкой возврата)

%a       24:4
%b       20:4
%op      16:4
%c       0:4
%u       29:1
%v       28:1
%imm     0:16
%off     0:20
%disp    0:s24
%cond    24:4

&rrr     a b c op u v
&rri     a b imm op u v
&mem     a b off u v
&breg    cond c v
&bdisp   cond disp v

# ── F0: регистр-регистр ────────────────────────────────────────────────────
# Биты 15:4 железо не читает; сохраняем как есть ради точного обратного хода.
F0_rrr   00 .. .... .... .... ------------ ....   &rrr a=%a b=%b c=%c op=%op u=%u v=%v

# ── F1: регистр-непосредственное ───────────────────────────────────────────
# v заодно задаёт заполнение старшей половины непосредственного.
F1_rri   01 .. .... .... .... ................    &rri a=%a b=%b imm=%imm op=%op u=%u v=%v

# ── F2: загрузка и запись ──────────────────────────────────────────────────
F2_mem   10 .. .... .... ....................     &mem a=%a b=%b off=%off u=%u v=%v

# ── F3: переход по адресу из регистра ──────────────────────────────────────
F3_reg   110 . .... -------------------- ....     &breg cond=%cond c=%c v=%v

# ── F3: переход по смещению ────────────────────────────────────────────────
# ORG.Mod излучает 24 бита, железо читает 22 — расхождение записано находкой 24.
F3_disp  111 . .... ........................      &bdisp cond=%cond disp=%disp v=%v
