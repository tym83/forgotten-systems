# Декодер RISC5 для QEMU (decodetree).
#
# Поля сняты не с документации, а с самого железа — RISC5.v Никлауса Вирта:
#   p=IR[31] q=IR[30] u=IR[29] v=IR[28]
#   a=IR[27:24]  b=IR[23:20]  op=IR[19:16]  c=IR[3:0]
# Те же значения использует наш дизассемблер, замкнутый в круг с ассемблером
# сплошным перебором пространства команд.
#
# Четыре формата различаются парой старших битов:
#   00uv  регистр-регистр        F0
#   01uv  регистр-непосредственное F1
#   10uv  загрузка/запись        F2   (u=0 читать, u=1 писать; v — байт)
#   110v  переход по регистру    F3
#   111v  переход по смещению    F3   (v — со ссылкой возврата)

%a       24:4
%b       20:4
%op      16:4
%c       0:4
%u       29:1
%v       28:1
%imm     0:16
%off     0:20
%disp    0:s24
%cond    24:4
%pay     4:20

&rrr     a b c op u v
&rri     a b imm op u v
&mem     a b off u v
&breg    cond c v pay
&bdisp   cond disp v

# ── CHK: аппаратная проверка границ массива ────────────────────────────────
# Кодировка снята с RISC5.v: p=0, q=0, u=0, v=1, op=1 — алиас LSL, которого
# компилятор не эмитит. Предел собирается из двух кусков {IR[27:24], IR[15:8]}:
# так он не перекрывает ни номер ловушки (7:4), ни поле позиции, которое читает
# Kernel.Trap. Номер ловушки декодеру не нужен — его читает система из слова
# команды, когда уже оказалась в обработчике.
#
# ⚠ Шаблон обязан стоять ДО F0_rrr: decodetree берёт первое совпадение, а эта
# кодировка — частный случай регистр-регистровой формы.
%chklim  24:4 8:8

&chk     b c lim

# ── F0: регистр-регистр, и внутри неё CHK ─────────────────────────────────
# Биты 15:4 железо не читает; сохраняем как есть ради точного обратного хода.
#
# ⚠ CHK — частный случай этой же формы, поэтому обе кодировки живут в одной
# группе: декодер пробует их по порядку. Порознь генератор их не принимает и
# правильно делает — перекрытие шаблонов молча меняло бы смысл старого кода.
{
  CHK    00 01 .... .... 0001 ........ ---- ....   &chk b=%b c=%c lim=%chklim
  F0_rrr 00 .. .... .... .... ------------ ....   &rrr a=%a b=%b c=%c op=%op u=%u v=%v
}

# ── F1: регистр-непосредственное ───────────────────────────────────────────
# v заодно задаёт заполнение старшей половины непосредственного.
F1_rri   01 .. .... .... .... ................    &rri a=%a b=%b imm=%imm op=%op u=%u v=%v

# ── F2: загрузка и запись ──────────────────────────────────────────────────
F2_mem   10 .. .... .... ....................     &mem a=%a b=%b off=%off u=%u v=%v

# ── F3: переход по адресу из регистра ──────────────────────────────────────
# Биты 23:4 — нагрузка ловушки: позиция в исходнике и номер. Компилятор кладёт
# её сюда, а обработчик достаёт, чтобы сказать, ГДЕ сработала проверка.
F3_reg   110 . .... .................... ....     &breg cond=%cond c=%c v=%v pay=%pay

# ── F3: переход по смещению ────────────────────────────────────────────────
# ORG.Mod излучает 24 бита, железо читает 22 — расхождение записано находкой 24.
F3_disp  111 . .... ........................      &bdisp cond=%cond disp=%disp v=%v
