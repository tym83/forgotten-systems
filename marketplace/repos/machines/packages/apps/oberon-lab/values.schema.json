{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "oberon-lab",
  "type": "object",
  "$comment": "Корень схемы НЕ закрыт намеренно: cozystack-engine подмешивает в values любого приложения тенанта свои ключи (_cluster, _namespace), и при additionalProperties:false Helm отвергает значения целиком — приложение не разворачивается. Ни один чарт платформы корень не закрывает. Вложенные объекты закрыты: туда движок ничего не кладёт.",
  "properties": {
    "web":      { "type": "boolean" },
    "replicas": { "type": "integer", "minimum": 0 },
    "host":     { "type": "string" },
    "ingressClassName": { "type": "string" },
    "runner":   { "type": "boolean" },
    "task":     { "type": "string", "enum": ["isa", "compiler", "check"] },
    "patch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path":    { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
          "content": { "type": "string" }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "runner"],
      "properties": {
        "web":    { "type": "string" },
        "runner": { "type": "string" }
      }
    },
    "runnerResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu":    { "type": "string" },
        "memory": { "type": "string" }
      }
    }
  }
}
