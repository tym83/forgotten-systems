{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "langpack",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "image", "mode"],
  "properties": {
    "language": { "type": "string", "minLength": 1 },
    "image":    { "type": "string", "minLength": 1 },
    "mode":     { "type": "string", "enum": ["service", "job"] },
    "command":  { "type": "array", "items": { "type": "string" } },
    "args":     { "type": "array", "items": { "type": "string" } },
    "program": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path":    { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "content": { "type": "string" }
        }
      }
    },
    "workdir":  { "type": "string", "pattern": "^/.*" },
    "srcdir":   { "type": "string", "pattern": "^/.*" },
    "replicas": { "type": "integer", "minimum": 0 },
    "port":     { "type": "integer", "minimum": 1, "maximum": 65535 },
    "host":     { "type": "string" },
    "ingressClassName": { "type": "string" },
    "backoffLimit": { "type": "integer", "minimum": 0 },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } }
    }
  }
}
