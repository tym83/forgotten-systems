# Пересборка системы, сессия 2 из 2: 20 модулей в 11 командах.
at 12000000
click 700 620 L
type ORP.Compile ORS.Mod/s ~
enter
type ORP.Compile TextFrames.Mod/s Tools.Mod/s Checkers.Mod/s ~
enter
type ORP.Compile Clipboard.Mod/s Edit.Mod/s GraphicFrames.Mod/s ~
enter
type ORP.Compile Hilbert.Mod/s MacroTool.Mod/s Net.Mod/s ~
enter
type ORP.Compile ORB.Mod/s ~
enter
type ORP.Compile ORG.Mod/s ~
enter
type ORP.Compile ORP.Mod/s ~
enter
type ORP.Compile ORTool.Mod/s Rectangles.Mod/s Sierpinski.Mod/s ~
enter
type ORP.Compile Stars.Mod/s ~
enter
type ORP.Compile System.Mod/s ~
enter
type ORP.Compile Curves.Mod/s Draw.Mod/s ~
wait 3000000
shot build/rb2_typed.pbm
click 690 569 M      # ORS
wait 25000000
shot build/rb2_c00.pbm
click 980 6 M
wait 2000000
