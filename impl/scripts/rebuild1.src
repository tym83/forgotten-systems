# Пересборка системы, сессия 1 из 2: 22 модулей в 11 командах.
at 12000000
click 700 620 L
type ORP.Compile Display.Mod/s ~
enter
type ORP.Compile Input.Mod/s Kernel.Mod/s Math.Mod/s ~
enter
type ORP.Compile PIO.Mod/s RS232.Mod/s SCC.Mod/s ~
enter
type ORP.Compile Viewers.Mod/s FileDir.Mod/s Files.Mod/s ~
enter
type ORP.Compile Fonts.Mod/s ~
enter
type ORP.Compile Modules.Mod/s ~
enter
type ORP.Compile Texts.Mod/s ~
enter
type ORP.Compile Oberon.Mod/s PCLink1.Mod/s ~
enter
type ORP.Compile RISC.Mod/s ~
enter
type ORP.Compile Blink.Mod/s EBNF.Mod/s GraphTool.Mod/s ~
enter
type ORP.Compile Graphics.Mod/s MenuViewers.Mod/s ORC.Mod/s ~
wait 3000000
