# Статическая часть: девять браузерных лабораторных и методичка.
# Здесь не нужен ни симулятор, ни компилятор — вся машина уже собрана в WASM,
# поэтому образ маленький и раздаётся обычным nginx.
#
# Берётся непривилегированный вариант: он слушает 8080 и работает от
# пользователя 101, то есть под обычными ограничениями кластера ему не нужен
# ни рут, ни записываемый корень. Конфигурация лежит в образе и НЕ должна
# перекрываться томом — иначе потеряется тип для wasm.
FROM nginxinc/nginx-unprivileged:1.29-alpine

COPY --chown=101:101 web/ /usr/share/nginx/html/

# WASM без правильного типа браузер отказывается компилировать потоком.
USER root
RUN printf '%s\n' \
  'types { application/wasm wasm; }' \
  'gzip on;' \
  'gzip_types application/wasm application/javascript text/css text/html;' \
  > /etc/nginx/conf.d/wasm.conf \
 && sed -i 's|index  index.html index.htm;|index lab.html index.html;|' \
      /etc/nginx/conf.d/default.conf
USER 101

EXPOSE 8080
