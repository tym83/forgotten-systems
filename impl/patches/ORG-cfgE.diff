>   PROCEDURE PutCHK(r, lim: LONGINT);
>   BEGIN (*hardware array bounds check, 12-bit limit, diagnostics preserved*)
>     (*F0 (p=0,q=0), v=1, op=1 (LSL alias). Index in field b. Limit split in two:
>       high 4 bits into IR[27:24] (field a, unused by CHK), low 8 bits into
>       IR[15:8]. Trap number 1 stays in IR[7:4] where Kernel.Trap expects it.
>       Register c = MT. On failure acts like BLR: R15 := return address,
>       PC := R[MT]. Never writes a register, never touches flags.
>       Rationale: dynamic profiling showed 68% of executed checks on compute
>       workloads hit arrays of 256..1023 elements, which an 8-bit limit misses.*)
>     code[pc] := 10000000H + (lim DIV 100H)*1000000H + r*100000H + 10000H
>               + (lim MOD 100H)*100H + 10H + MT; INC(pc)
>   END PutCHK;
> 
